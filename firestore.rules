rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Apps Collection
    match /apps/{appId} {
      allow read: if true; // Public listings
      allow write: if false; // Only system/admin (not implemented yet, default deny for safety)
    }

    // Pricing Plans
    match /pricingPlans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['email']) &&
               data.email is string && data.email.size() <= 256 &&
               (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
               (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
               (!('isAffiliate' in data) || (data.isAffiliate is bool)) &&
               (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 100));
      }

      allow get: if isOwner(userId);
      allow list: if false; // Prevents user scraping
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'favorites', 'isAffiliate'])
      );
    }
  }
}
