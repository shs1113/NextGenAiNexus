rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'shs1113@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Apps Collection
    match /apps/{appId} {
      function isValidApp(data) {
        return data.keys().hasAll(['name', 'description', 'category', 'tag']) &&
               data.name is string && data.name.size() <= 256 &&
               data.description is string && data.description.size() <= 8192 &&
               data.category is string && data.category.size() <= 128 &&
               data.tag is string && (data.tag == 'FREE' || data.tag == 'TRIAL' || data.tag == 'PAID');
      }

      allow read: if true; // Public listings
      allow create, update: if isAdmin() && isValidApp(incoming());
      allow delete: if isAdmin();
    }

    // Pricing Plans
    match /pricingPlans/{planId} {
      allow read: if true;
      allow write: if false;
    }

    // Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.keys().hasAll(['email']) &&
               data.email is string && data.email.size() <= 256 &&
               (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
               (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
               (!('isAffiliate' in data) || (data.isAffiliate is bool)) &&
               (!('favorites' in data) || (data.favorites is list && data.favorites.size() <= 100));
      }

      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Allow admin to retrieve members list for managing
      
      allow create: if (isOwner(userId) || isAdmin()) && isValidUser(incoming());
      allow update: if isAdmin() || (isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'favorites', 'isAffiliate'])
      ));
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Contacts Collection
    match /contacts/{contactId} {
      function isValidContact(data) {
        return data.keys().hasAll(['name', 'email', 'sector', 'message']) &&
               data.name is string && data.name.size() <= 256 &&
               data.email is string && data.email.size() <= 256 &&
               data.sector is string && data.sector.size() <= 256 &&
               data.message is string && data.message.size() <= 10240;
      }

      allow create: if isValidContact(incoming());
      allow get, list, update, delete: if isAdmin();
    }

    // Payments Collection
    match /payments/{paymentId} {
      function isValidPayment(data) {
        return data.keys().hasAll(['paymentChannel', 'planId', 'amount', 'billingEmail', 'transactionId', 'status']) &&
               data.paymentChannel is string && data.paymentChannel.size() <= 64 &&
               data.planId is string && data.planId.size() <= 128 &&
               data.amount is number &&
               data.billingEmail is string && data.billingEmail.size() <= 256 &&
               data.transactionId is string && data.transactionId.size() <= 256 &&
               data.status is string && data.status == 'pending_verification' &&
               (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 256)) &&
               (!('senderAccount' in data) || (data.senderAccount is string && data.senderAccount.size() <= 256)) &&
               (!('receiptFile' in data) || (data.receiptFile == null || (data.receiptFile is string && data.receiptFile.size() <= 2048)));
      }

      allow create: if isValidPayment(incoming());
      allow get, list, update, delete: if isAdmin();
    }
  }
}
